rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Coach UID ────────────────────────────────────────────────────────────
    // Hardcoded alpha/coach account — can read all user data via collectionGroup.
    function isCoach() {
      return request.auth != null && request.auth.uid == '59ole36uNpNwml5H6VDYCXyCME92';
    }

    // ── Own data ─────────────────────────────────────────────────────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Global KB (read-only for all authenticated users) ────────────────────
    match /fitness/kb/{document=**} {
      allow read:  if request.auth != null;
      allow write: if isCoach();
    }

    // ── Per-user data ─────────────────────────────────────────────────────────
    match /fitness/{uid}/{document=**} {
      // User reads/writes their own data; coach reads all
      allow read:  if isOwner(uid) || isCoach();
      allow write: if isOwner(uid) || isCoach();
    }

    // ── collectionGroup queries (Coach-only: global feed + inbox sweep) ───────
    // Firestore requires explicit collectionGroup rules for cross-user queries.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isCoach() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    // Live-Traction: collectionGroup reads are limited to the Coach account.
    match /{path=**}/tractionDaily/{dayId} {
      allow read: if isCoach();
    }
    match /{path=**}/inbox/{itemId} {
      allow read:  if isCoach() || (request.auth != null && resource.data.userId == request.auth.uid);
      // Users always write inbox via direct path /fitness/{uid}/inbox (covered by per-user rule).
      // CollectionGroup writes are coach-only (approve/reject).
      allow write: if isCoach();
    }
    match /{path=**}/profile/{doc} {
      // User reads own profile via /fitness/{uid}/... (per-user rule above).
      // CollectionGroup access is coach-only — no leaking profiles across users.
      allow read: if isCoach();
    }
    match /{path=**}/habitJournals/{doc} {
      allow read:  if isCoach() || (request.auth != null && resource.data.userId == request.auth.uid);
      // request.resource.data = incoming document (works on create + update).
      // resource.data = existing document (fails on create — document doesn't exist yet).
      allow write: if isCoach() || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }

    // ── Fuel: Nutrition & Supplements ────────────────────────────────────────
    match /nutrition/{uid}/meta/catalog {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /supplements/{uid}/meta/catalog {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /nutrition/public/meta/micros {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via SDK
    }
    match /nutrition/{uid}/logs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /supplements/{uid}/logs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Relax ─────────────────────────────────────────────────────────────────
    match /relax/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared Knowledge ─────────────────────────────────────────────────────
    match /knowledge/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }
    match /knowledge_tasks/{taskId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false; // Admin SDK only
    }
  }
}
