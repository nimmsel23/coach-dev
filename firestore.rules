rules_version = '2';

// Coach-App Rules (coach-dev / vos-coach).
// This file is the app-owned rule contract. The deployable ruleset is
// registered in ~/vitalos/firestore.rules and deployed only from ~/vitalos.

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }
    function owner(uid) {
      return authed() && request.auth.uid == uid;
    }
    function isCoach() {
      return authed() && (
        request.auth.token.coach == true
        || request.auth.uid == '59ole36uNpNwml5H6VDYCXyCME92'
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'coach')
      );
    }

    match /roles/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    // Hosted Coach reads local Python snapshots and submits reviewed commands.
    // Only the local Admin SDK worker may publish snapshots or finish commands.
    match /coachInbox/{id} {
      allow read: if isCoach();
      allow write: if false;
    }
    match /coachState/{id} {
      allow read: if isCoach();
      allow write: if false;
    }
    match /coachCommands/{id} {
      allow read: if isCoach();
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(['action', 'item_id', 'uid', 'payload', 'requested_by', 'status', 'created_at'])
        && request.resource.data.requested_by == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.action in ['approve', 'reenrich', 'delete', 'link-source', 'duplicates', 'merge-duplicates']
        && request.resource.data.item_id is string
        && request.resource.data.item_id.size() > 0
        && request.resource.data.item_id.size() <= 200
        && request.resource.data.payload is map;
      allow update, delete: if false;
    }

    // Coach needs full direct access to client fitness records for review,
    // feedback, routine edits, assigned plans, macrocycles and habit-cycle setup.
    match /fitness/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }

    // Curated KB: clients can read, only Coach can edit.
    match /fitness/kb/{document=**} {
      allow read: if authed();
      allow write: if isCoach();
    }

    // Global Coach inbox sweep; user writes remain covered by /fitness/{uid}/...
    match /{path=**}/inbox/{id} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      allow write: if isCoach();
    }

    // Global Coach activity/profile feeds.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      allow write: if isCoach();
    }
    match /{path=**}/journal/{doc} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      allow write: if isCoach();
    }
    match /{path=**}/habitJournals/{doc} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      allow write: if isCoach();
    }
    match /{path=**}/profile/{doc} {
      allow read: if isCoach();
    }
    match /{path=**}/settings/{doc} {
      allow read, write: if isCoach();
    }

    // Explicit Coach app collections for cross-client admin surfaces.
    // Direct owner/client access is granted by /fitness/{uid}/{document=**}.
    match /{path=**}/routines/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/wf_workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/macrocycles/{doc} {
      allow read, write: if isCoach();
    }
  }
}
