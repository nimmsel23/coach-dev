{
  "name": "coach",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "predev": "pnpm run build:kb-data && node scripts/prepare-shared-plan.mjs",
    "dev": "node scripts/dev-runner.mjs",
    "start": "python3 server.py",
    "ui:dev": "vite --mode coach --open /coach-shell.html",
    "test:local:browser": "bash scripts/tests/run-local-browser.sh",
    "test:plan:browser": "bash scripts/tests/run-shared-editor-browser.sh",
    "test:plan:contract": "node scripts/tests/plan-contract.test.mjs",
    "lint": "eslint src/ --ext .js,.jsx",
    "prebuild": "pnpm run build:kb-data",
    "build": "pnpm run lint && pnpm run build:firebase:coach",
    "build:preview": "pnpm run deploy:preview",
    "prebuild:firebase": "pnpm run build:kb-data",
    "build:kb-data": "pnpm run build:sixpack-data && pnpm run build:exercise-data && pnpm run build:coaching-notes",
    "build:sixpack-data": "node scripts/build-sixpack-data.mjs",
    "build:exercise-data": "node scripts/exercise-data.mjs",
    "build:bulk-data": "node scripts/build-exercise-bulk-data.mjs",
    "build:ppl-data": "node scripts/build-ppl-data.mjs",
    "build:coaching-notes": "node scripts/build-coaching-notes.mjs",
    "build:firebase": "pnpm run build:firebase:coach",
    "build:firebase:coach": "node scripts/prepare-shared-plan.mjs && vite build --mode coach --outDir dist-coach && node scripts/prepare-coach-dist.mjs && node scripts/mini-app-shell/cli.mjs stamp dist-coach --app coach && node scripts/snapshot.mjs dist-coach",
    "stamp:sw": "node scripts/mini-app-shell/cli.mjs stamp dist-coach --app coach",
    "preview:firebase": "firebase hosting:channel:deploy preview --only coach --expires 1h",
    "deploy:firebase": "firebase deploy --only hosting:coach",
    "firebase": "pnpm run build:firebase && pnpm run deploy:firebase",
    "deploy": "node scripts/deploy-runner.mjs",
    "deploy:local": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "preview": "vite preview --mode coach --outDir dist-coach",
    "build:catalog": "python3 scripts/build-catalog.py",
    "deploy:preview": "pnpm run build:firebase && node scripts/deploy-preview.mjs",
    "deploy:prev": "pnpm run deploy:preview",
    "build:prev": "pnpm run deploy:preview",
    "server": "python3 server.py",
    "server:dev": "python3 server.py --reload",
    "build:catalog-ui": "node scripts/build-catalog-ui.mjs",
    "tooling:biome": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=false --no-errors-on-unmatched scripts",
    "tooling:knip": "pnpm dlx knip@6.44.2 --no-progress",
    "tooling:check": "pnpm run tooling:biome && pnpm run tooling:knip",
    "test": "node --test scripts/smoke.test.mjs",
    "tooling:biome:lint": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=true --no-errors-on-unmatched scripts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-query": "^5.107.1",
    "better-sqlite3": "^12.11.1",
    "body-muscles": "^1.0.0",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "hono": "^4.13.17",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.577.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-is": "^19.3.1",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.10.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "vite": "6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  },
  "engines": {
    "node": ">=22.13"
  }
}
