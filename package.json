{
  "name": "fitness-dev",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "predev": "pnpm run build:kb-data",
    "dev": "node scripts/dev-runner.mjs",
    "start": "node server.mjs",
    "fitness:routines": "node scripts/fitness-routines.mjs",
    "ui:dev": "vite",
    "lint": "eslint src/ --ext .js,.jsx",
    "prebuild": "pnpm run build:kb-data",
    "build": "pnpm run lint && vite build && node scripts/mini-app-shell/cli.mjs sw dist --app fitness && node scripts/mini-app-shell/cli.mjs splash dist --app fitness && node scripts/snapshot.mjs dist",
    "build:preview": "pnpm run deploy:preview",
    "prebuild:firebase": "pnpm run build:kb-data",
    "build:kb-data": "pnpm run build:sixpack-data && pnpm run build:exercise-data && pnpm run build:coaching-notes && pnpm run build:plan-data",
    "build:sixpack-data": "node scripts/build-sixpack-data.mjs",
    "build:exercise-data": "node scripts/exercise-data.mjs",
    "build:bulk-data": "node scripts/build-exercise-bulk-data.mjs",
    "build:ppl-data": "node scripts/build-ppl-data.mjs",
    "build:coaching-notes": "node scripts/build-coaching-notes.mjs",
    "build:firebase": "pnpm run build:firebase:client",
    "build:firebase:client": "vite build --mode firebase --outDir dist-firebase && node scripts/mini-app-shell/cli.mjs sw dist-firebase --app fitness && node scripts/mini-app-shell/cli.mjs splash dist-firebase --app fitness && node scripts/snapshot.mjs dist-firebase",
    "stamp:sw": "node scripts/mini-app-shell/cli.mjs sw dist-firebase --app fitness",
    "preview:firebase": "firebase hosting:channel:deploy preview --expires 1h",
    "deploy:firebase": "firebase deploy --only hosting:client",
    "firebase": "pnpm run build:firebase && pnpm run deploy:firebase",
    "build:training": "pnpm run build:kb-data && vite build --mode training --outDir dist-training && node scripts/mini-app-shell/cli.mjs sw dist-training --app fitness && node scripts/stamp-training.mjs dist-training && node scripts/snapshot.mjs dist-training",
    "build:plan": "pnpm run build:kb-data && vite build --mode plan --outDir dist-plan && node scripts/prepare-plan-dist.mjs dist-plan && node scripts/mini-app-shell/cli.mjs stamp dist-plan --app plan && node scripts/snapshot.mjs dist-plan",
    "deploy:training": "firebase deploy --only hosting:training",
    "deploy:plan": "firebase deploy --only hosting:plan",
    "plan": "pnpm run build:plan && pnpm run deploy:plan",
    "training": "pnpm run build:training && pnpm run deploy:training",
    "build:atlas": "pnpm run build:kb-data && vite build --mode atlas --outDir dist-atlas && node scripts/mini-app-shell/cli.mjs sw dist-atlas --app fitness && node scripts/stamp-training.mjs dist-atlas \"VitalOS Atlas\" Atlas \"/#atlas\" \"Übungsdatenbank durchsuchen — Atlas als eigene App\" && node scripts/snapshot.mjs dist-atlas",
    "deploy:atlas": "firebase deploy --only hosting:atlas",
    "atlas": "pnpm run build:atlas && pnpm run deploy:atlas",
    "deploy": "node scripts/deploy-runner.mjs",
    "deploy:local": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "preview": "vite preview",
    "build:catalog": "python3 scripts/build-catalog.py",
    "deploy:preview": "pnpm run build:firebase && node scripts/deploy-preview.mjs",
    "deploy:prev": "pnpm run deploy:preview",
    "build:prev": "pnpm run deploy:preview",
    "build:plan-data": "node scripts/build-plan-data.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/ai": "^1.4.1",
    "@firebase/app": "^0.16.4",
    "@firebase/auth": "^1.13.8",
    "@firebase/component": "^0.7.5",
    "@firebase/firestore": "^4.19.0",
    "@firebase/functions": "^0.14.0",
    "@firebase/installations": "^0.6.24",
    "@firebase/logger": "^0.5.2",
    "@firebase/messaging": "^0.13.3",
    "@firebase/util": "^1.15.3",
    "@firebase/webchannel-wrapper": "^1.0.7",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@standard-schema/spec": "^1.1.0",
    "@standard-schema/utils": "^0.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@we-gold/gpxjs": "^1.2.0",
    "base64-js": "1.5.1",
    "better-sqlite3": "^13.0.3",
    "body-muscles": "^1.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "d3-timer": "^3.0.1",
    "date-fns": "^4.4.0",
    "decimal.js-light": "^2.5.1",
    "es-toolkit": "^1.53.0",
    "eventemitter3": "^5.0.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "fit-file-parser": "^5.2.1",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "ieee754": "1.2.1",
    "immer": "^10.2.0",
    "internmap": "^2.0.3",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.453.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "re2js": "^2.9.0",
    "react": "^19.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-muscle-highlighter": "^1.2.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "scheduler": "0.28.0",
    "tiny-invariant": "^1.3.3",
    "tslib": "^2.8.1",
    "use-sync-external-store": "^1.7.0",
    "victory-vendor": "^37.3.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.13",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
