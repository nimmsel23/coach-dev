[Unit]
Description=Coach backend (Fitness, Fuel, embedded Relax) :9150 + Alias-Ports :8788 :5200
After=network.target
# vital-hub.service = Alias dieser Unit (Hub :8788 läuft in derselben Coach-App)
Conflicts=vital-hub-konsole.service

[Service]
Type=simple
WorkingDirectory=%h/dev/coach-dev
ExecStart=/usr/bin/python3 %h/dev/coach-dev/server.py
Environment=COACH_HOST=127.0.0.1
Environment=COACH_PORT=9150
# Einziger Nutzerdaten-Sync (Firestore <-> ~/.aos/users); fitness-preview.service nicht parallel.
Environment=FITNESS_SYNC_OWNER=1
Environment=COACH_ALIAS_PORT=8788,5200
Environment=COACH_FITNESS_BACKEND_ROOT=%h/dev/coach-dev/backend
Environment=PYTHONPATH=%h/dev/coach-dev/backend:%h/dev/coach-dev:%h/dev/coach-dev/anatomy-kb
EnvironmentFile=-%h/.config/coach/backend.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
Alias=fitness-api.service vital-hub.service
