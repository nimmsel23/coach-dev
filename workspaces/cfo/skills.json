{
  "workspaceId": "cfo",
  "roleTitle": "Chief Financial Officer — Umsatz, Posten & Belege",
  "defaultModel": "gemini",
  "temperature": 0.2,
  "version": "1.1",
  "tools": [
    {
      "name": "summarize_month_revenue",
      "description": "Monatsumsatz-Snapshot (Ist/Offen/fehlt). Intern — keine Klientenkommunikation.",
      "requiresApproval": false,
      "parameters": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "YYYY-MM oder current."
          }
        }
      }
    },
    {
      "name": "draft_invoice_reminder",
      "description": "Höfliche Zahlungserinnerung (Text). Immer pending_approval — kein Versand ohne Freigabe.",
      "requiresApproval": true,
      "parameters": {
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string",
            "description": "Name des Schuldners/Klienten."
          },
          "amount": {
            "type": "string",
            "description": "Betrag inkl. Währung."
          },
          "dueDate": {
            "type": "string",
            "description": "Fälligkeitsdatum falls bekannt."
          }
        },
        "required": ["clientName", "amount"]
      }
    },
    {
      "name": "package_price_check",
      "description": "Preis-/Paket-Check mit markierten Annahmen. Freigabe nötig, wenn an Klient kommuniziert werden soll.",
      "requiresApproval": true,
      "parameters": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "description": "Paketname."
          },
          "proposedPrice": {
            "type": "string",
            "description": "Vorgeschlagener Preis oder 'fehlt'."
          }
        },
        "required": ["package"]
      }
    },
    {
      "name": "open_items_list",
      "description": "Listet offene Posten aus Kontext/Stub. Interne Übersicht.",
      "requiresApproval": false,
      "parameters": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "description": "Stichtag."
          }
        }
      }
    },
    {
      "name": "expense_note",
      "description": "Belegnotiz für die Buchhaltung (Vendor, Betrag, Kategorie). Intern.",
      "requiresApproval": false,
      "parameters": {
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Lieferant/Anbieter."
          },
          "amount": {
            "type": "string",
            "description": "Betrag."
          },
          "category": {
            "type": "string",
            "description": "Kategorie (tools, hosting, …)."
          }
        },
        "required": ["vendor", "amount"]
      }
    },
    {
      "name": "cashflow_snapshot",
      "description": "Kurzfristiger Cashflow-Überblick; Unsicherheiten als fehlt markieren. Intern.",
      "requiresApproval": false,
      "parameters": {
        "type": "object",
        "properties": {
          "horizonDays": {
            "type": "number",
            "description": "Horizont in Tagen (Default 14)."
          }
        }
      }
    }
  ],
  "collections": {
    "readAccess": [
      "csuite/cfo/approvals",
      "csuite/cfo/threads",
      "csuite/cfo/agent_logs"
    ],
    "writeAccess": [
      "csuite/cfo/approvals",
      "csuite/cfo/threads",
      "csuite/cfo/agent_logs"
    ],
    "notes": "Keine Steuerberatung. Outbound nur über approvals pending_approval. Zahlenquellen: Konsole/CRM / CEO-Input."
  }
}
