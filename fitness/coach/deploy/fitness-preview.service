# Fitness domain upstream for Coach :9150. Same source/catalog as coach-sync.
# Install: ln -s <repo>/fitness/coach/deploy/fitness-preview.service ~/.config/systemd/user/
[Unit]
Description=Fitness Domain API (Coach upstream :8100)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/fitness-dev
ExecStart=%h/.local/share/uv/tools/fitness-agent/bin/python3 -m uvicorn fitness.api.main:app --host 127.0.0.1 --port 8100 --no-access-log
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=FITNESS_ENV=dev
Environment=FITNESS_PYTHON_PORT=8100
Environment=FITNESS_SKIP_WATCHERS=1
# Retain this existing service's user-data sync ownership; catalog belongs to coach-sync.
Environment=FITNESS_SYNC_OWNER=1

[Install]
WantedBy=default.target
