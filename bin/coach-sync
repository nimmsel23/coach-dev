#!/usr/bin/env bash
# coach-sync — Coach Firestore worker (same as: coach sync)
set -euo pipefail
COACH="${COACH_DEV:-$HOME/dev/coach-dev}"
BACKEND="${BACKEND_FITNESS_ROOT:-$HOME/dev/backend/fitness}"
export PYTHONPATH="${COACH}:${BACKEND}${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c 'import sys; from fitness.coach.sync import app; sys.argv[0]="coach-sync"; app()' "$@"
