#!/bin/bash
# Hosting releases are owned by Coach CI or bin/coach-release.
# This hook only retains the existing GAS summary deployment on dev.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

should_clasp_deploy=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  branch="${local_ref#refs/heads/}"

  [ "$branch" = "dev" ] || continue
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] || continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    changed="$(git log --format= --name-only "$local_sha" -- gas-coach-summary/)"
  else
    changed="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi

  if [ "$branch" = "dev" ] && echo "$changed" | grep -Eq '^gas-coach-summary/'; then
    should_clasp_deploy=true
  fi
done

COACH_SUMMARY_DEPLOYMENT_ID="AKfycbzYPrXQMym0hR7qexG3HcKI12oWSEgoxt0h5mStFh7PRWZzU7g_ZzisJdybN4m4yXzq"

if [ "$should_clasp_deploy" = true ]; then
  echo "coach-dev: gas-coach-summary/ changes detected; clasp push + deploy..."
  (
    cd gas-coach-summary
    clasp push --force
    clasp deploy -i "$COACH_SUMMARY_DEPLOYMENT_ID" -d "auto-deploy $(date -Iseconds)"
  )
  echo "coach-dev: gas-coach-summary deployed."
else
  echo "coach-dev: no gas-coach-summary/ changes in pushed dev range; skipping clasp deploy."
fi
