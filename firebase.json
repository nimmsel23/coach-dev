{
  "_note": "Firestore rules SSOT = ~/vitalos/firestore.rules \u2014 NEVER add a firestore block here or deploy rules from coach-dev. Only vitalos deploys rules.",
  "hosting": [
    {
      "target": "coach",
      "public": "dist-coach",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/coach/coo/dashboard",
          "destination": "/workspaces/coo/dashboard.html"
        },
        {
          "source": "/coach/coo/dashboard/",
          "destination": "/workspaces/coo/dashboard.html"
        },
        {
          "source": "/coach/ceo",
          "destination": "/ceo.html"
        },
        {
          "source": "/coach/ceo/",
          "destination": "/ceo.html"
        },
        {
          "source": "/coach/coo",
          "destination": "/workspaces/coo/dashboard.html"
        },
        {
          "source": "/coach/coo/",
          "destination": "/workspaces/coo/dashboard.html"
        },
        {
          "source": "/coach/cmo",
          "destination": "/workspaces/cmo/dashboard.html"
        },
        {
          "source": "/coach/cmo/",
          "destination": "/workspaces/cmo/dashboard.html"
        },
        {
          "source": "/coach/cso",
          "destination": "/workspaces/cso/dashboard.html"
        },
        {
          "source": "/coach/cso/",
          "destination": "/workspaces/cso/dashboard.html"
        },
        {
          "source": "/coach/cpo",
          "destination": "/workspaces/cpo/dashboard.html"
        },
        {
          "source": "/coach/cpo/",
          "destination": "/workspaces/cpo/dashboard.html"
        },
        {
          "source": "/coach/cto",
          "destination": "/workspaces/cto/dashboard.html"
        },
        {
          "source": "/coach/cto/",
          "destination": "/workspaces/cto/dashboard.html"
        },
        {
          "source": "/coach/cfo",
          "destination": "/workspaces/cfo/dashboard.html"
        },
        {
          "source": "/coach/cfo/",
          "destination": "/workspaces/cfo/dashboard.html"
        },
        {
          "source": "/portal",
          "destination": "/portal.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/release.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/coach-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/coach-manifest.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
