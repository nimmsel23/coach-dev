#!/usr/bin/env bash
# anatomy — Top-Level Dispatcher für anatomy-kb
# Server-Kontrolle via kbctl, Learning-CLI via anatomy-agent
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"

have_gum() { command -v gum >/dev/null 2>&1; }
err() { have_gum && gum log --level error "$*" >&2 || printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }

SERVER_CMDS="start|stop|restart|status|health|logs"
AGENT_CMDS="list|pick|show|teach|errors|quiz|flashcard|enrich|ingest|audit|reload|doctor|serve|approve|refine"

usage() {
  cat <<EOF

  anatomy — Anatomy Intelligence Layer

  Server-Kontrolle:
    anatomy start              Server :9200 starten
    anatomy stop               Server stoppen
    anatomy restart            Restart
    anatomy status             PID + Port + Uptime
    anatomy health             /health prüfen
    anatomy logs               Server-Log live

  Learning:
    anatomy teach  <id>        Anatomy-Teaching (Erklärung, Gelenke, Muskeln)
    anatomy errors <id>        Fehlerbilder mit anatomischer Begründung
    anatomy quiz   <id>        Quiz — Enter zum Aufdecken
    anatomy flashcard          Ursprung & Ansatz Flashcard-Modus
    anatomy list               Alle Übungen
    anatomy pick               fzf-Auswahl → teach
    anatomy show   <id>        YAML-Rohdaten

  Katalog:
    anatomy ingest <notiz>     Vault-Notiz → Gemini → YAML
    anatomy enrich <id>        Ursprung/Ansatz via Gemini generieren
    anatomy approve <id>       Übung von Bulk/Inbox → Expert heben
    anatomy refine             Meistgenutzte unreviewed Übungen draften
    anatomy audit              Katalog-Integrität prüfen

  System:
    anatomy reload             YAML-Cache leeren
    anatomy doctor             Health-Check

EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  start|stop|restart|status|health|logs)
    exec "$ROOT/kbctl" "$cmd" "$@"
    ;;
  list|pick|show|teach|errors|quiz|flashcard|enrich|ingest|audit|reload|doctor|serve|approve|refine)
    exec "$ROOT/anatomy-agent" "$cmd" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    err "Unbekannter Befehl: $cmd"
    usage
    exit 1
    ;;
esac
